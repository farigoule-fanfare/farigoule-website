{
	# Désactive l'attribution automatique de HTTPS car Caddy est derrière un autre proxy
	auto_https off
}

:80 {
    root * /usr/share/caddy

    # Redirige les requêtes API vers le Backend (conserve le préfixe /api/)
    handle /api/* {
        reverse_proxy {$API_BACKEND_URL}
    }

    # Redirige l'accès aux images/fichiers statiques du backend
    handle /public/* {
        reverse_proxy {$API_BACKEND_URL}
    }

    # Redirige le sitemap généré par le backend
    handle /sitemap.xml {
        reverse_proxy {$API_BACKEND_URL}
    }

    # Fallback pour le SPA (React) : tout ce qui n'est pas API, public ou sitemap
    handle {
        try_files {path} /index.html
        file_server
    }
}
