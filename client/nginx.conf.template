events {}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  server {
    listen 80;
    root  /usr/share/nginx/html;
    index index.html;
    access_log /dev/stdout;

    # ---------- Pages supprimées / anciennes .php ----------
    # Supprimées définitivement -> 410
    location = /chat.php        { return 410; }
    location = /tartiflette.php { return 410; }

    # Anciennes routes .php qui ont un équivalent -> 301
    location /index.php      { return 301 $scheme://$http_host/; }
    location /portraits.php  { return 301 $scheme://$http_host/portraits; }
    location /contact.php    { return 301 $scheme://$http_host/contact; }
    location /nous.php       { return 301 $scheme://$http_host/nous; }
    location /symphonies.php { return 301 $scheme://$http_host/symphonies; }

    # ---------- Static & cache ----------
    location /static/  { try_files $uri =404; expires 1y; }
    location /assets/  { try_files $uri =404; expires 1y; }

    # ---------- API / Backend ----------
    location /api/ {
      proxy_pass ${API_BACKEND_URL};
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_cache_bypass $http_upgrade;
    }

    location /public/ {
      proxy_pass ${API_BACKEND_URL}/public/;
    }

    location /sitemap.xml {
      proxy_pass ${API_BACKEND_URL}/sitemap.xml;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- SPA fallback classique ----------
    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
